# Copy to .env (gitignored). Never commit real values.
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=fantasy
POSTGRES_DB=fantasy
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://fantasy:fantasy@127.0.0.1:5432/fantasy

DEMO_MODE=false

# Optional: your Sleeper username, used by verify-sources for a shape-only league check.
SLEEPER_USERNAME=

# Claude API key for the chat router and answers (console.anthropic.com; billed per use).
ANTHROPIC_API_KEY=

# Which provider answers chat: anthropic (paid, above) or openrouter (free models only).
LLM_PROVIDER=anthropic
# OpenRouter key (openrouter.ai/keys). Only ":free" model IDs are accepted, so it never spends.
# Free models: 20 requests/min; 50/day, or 1,000/day once $10 of credits were ever bought.
OPENROUTER_API_KEY=
OPENROUTER_ROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
